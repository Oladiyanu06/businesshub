# BUSINESSHUB environment configuration
# Copy this file to .env.local and fill in your Supabase project values.

# Public Supabase project URL (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (safe to expose; row-level security applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER ONLY. Bypasses row-level security.
# Used exclusively for Supabase Auth administration (create/delete users,
# password resets). Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used for redirects and generated links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Signs short-lived password-recovery cookies. Defaults to the
# service-role key when unset; set a separate random value in production.
# PASSWORD_RECOVERY_SECRET=
